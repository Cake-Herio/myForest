<navigation-bar title="专注计时" color="#2F3A34" background="#EDF7EE"></navigation-bar>

<view class="page focus-page">
  <view class="task-card card">
    <view class="muted">计时中不能修改模式，结束后再补充记录</view>
    <view class="task-title">{{taskTitle}}</view>
    <view class="choice-row">
      <view class="choice-chip active">{{timerType === 'countup' ? '正计时' : '倒计时'}}</view>
      <view class="choice-chip active {{timerMode === 'shallow' ? 'blue' : ''}}">{{timerMode === 'deep' ? '深度计时' : '浅度计时'}}</view>
    </view>
  </view>

  <view class="timer card">
    <view class="tree">树</view>
    <view class="time">{{timeText}}</view>
    <view class="muted">
      {{isPaused ? '已暂停，回来后可以继续' : (isRunning ? '保持稳定呼吸，慢慢推进' : '准备好后再开始')}}
    </view>
  </view>

  <view class="control-row">
    <button wx:if="{{!isRunning}}" class="control-button primary-button" bindtap="startTimer">重新开始</button>
    <block wx:else>
      <button class="control-button secondary-button" bindtap="togglePause">{{isPaused ? '继续' : '暂停'}}</button>
      <button class="control-button primary-button" bindtap="finishFocus">结束</button>
    </block>
  </view>

  <view wx:if="{{isFinishPanelVisible}}" class="finish-mask" catchtouchmove="noop">
    <view class="finish-panel">
      <view class="finish-title">这次完成了什么？</view>
      <view class="muted">选择标签，详情可以打字或后续接语音输入</view>

      <view class="finish-tags">
        <view
          wx:for="{{tags}}"
          wx:key="*this"
          class="finish-tag {{selectedTag === item ? 'active' : ''}}"
          data-tag="{{item}}"
          bindtap="selectTag"
        >
          {{item}}
        </view>
      </view>

      <textarea class="detail-input" value="{{detail}}" placeholder="具体做了什么？例如：背完 Unit 3 单词" bindinput="onDetailInput"></textarea>

      <view class="finish-actions">
        <button class="finish-button secondary-button" bindtap="closeFinishPanel">先不记录</button>
        <button class="finish-button primary-button" bindtap="saveCompletion">保存记录</button>
      </view>
    </view>
  </view>
</view>
